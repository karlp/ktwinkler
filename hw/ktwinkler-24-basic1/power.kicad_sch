	(text "TI promises a single 0805 output, 47uf! not sure...."
		(exclude_from_sim no)
		(at 145.288 281.178 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e03b51fc-ecb2-4780-a15d-97033af5970f")
